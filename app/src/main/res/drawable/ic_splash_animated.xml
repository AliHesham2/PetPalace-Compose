<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_splash_animated.xml
    Ties ic_splash_icon (the vector) with splash_icon_animator (the animator).
    Used as splashScreenIntroAnimatedIcon in the splash theme.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_icon">

    <target
        android:name="logo_group"
        android:animation="@animator/splash_icon_animator" />

</animated-vector>
