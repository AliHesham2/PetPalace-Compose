    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="logo_group"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-180"
        android:scaleX="0"
        android:scaleY="0">

        <!-- Badge circle: 2/3 of the icon, which leaves room for the overshoot of the entry
             animation -->
        <path
            android:fillColor="#651FFF"
            android:pathData="M54,54m-36,0a36,36 0 1,1 72,0a36,36 0 1,1 -72,0" />

        <!-- Toe 1 -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M37.5,41.5m-5,0a5,5 0 1,1 10,0a5,5 0 1,1 -10,0" />
        <!-- Toe 2 -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M48.5,33.5m-5.8,0a5.8,5.8 0 1,1 11.6,0a5.8,5.8 0 1,1 -11.6,0" />
        <!-- Toe 3 -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M59.5,33.5m-5.8,0a5.8,5.8 0 1,1 11.6,0a5.8,5.8 0 1,1 -11.6,0" />
        <!-- Toe 4 -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M70.5,41.5m-5,0a5,5 0 1,1 10,0a5,5 0 1,1 -10,0" />

        <!-- Main Palm Pad with Heart Cutout -->
        <path android:fillColor="#FFFFFF"
