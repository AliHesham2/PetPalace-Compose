<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_splash_icon.xml
    The splash logo, with all paths wrapped inside a named <group> so the
    AnimatedVectorDrawable can target it. The group starts collapsed
    (scale 0, rotated back): splash_icon_animator brings it in.
-->
