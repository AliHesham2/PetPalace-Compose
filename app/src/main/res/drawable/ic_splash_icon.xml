            android:pathData="M54,49 C43.5,49 36,55.5 36,64 C36,70.5 41.5,76.5 48,76.5 C51,76.5 52.5,75 54,75 C55.5,75 57,76.5 60,76.5 C66.5,76.5 72,70.5 72,64 C72,55.5 64.5,49 54,49 Z M54,69 C54,69 46.5,64 46.5,59.8 C46.5,57.5 48.2,55.8 50.5,55.8 C52,55.8 53.3,56.8 54,58 C54.7,56.8 56,55.8 57.5,55.8 C59.8,55.8 61.5,57.5 61.5,59.8 C61.5,64 54,69 54,69 Z" />

